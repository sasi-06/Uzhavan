# ==========================================
# Uzhavan Project Git Ignore Rules
# Safeguarding all secrets, keys, and credentials
# ==========================================

# ── Environment & Secrets ───────────────────
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

# ── Firebase & Cloud Credentials ───────────
**/service-account.json
**/service-account*.json
**/*serviceAccountKey*.json
**/*service-account*.json
**/firebase-adminsdk*.json
**/google-services.json
**/GoogleService-Info.plist
!**/service-account.example.json
!service-account.example.json

# ── Private Keys, Keystores & Certificates ─
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore

# ── Dependencies ───────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Build Artifacts ────────────────────────
dist/
**/dist/
build/
**/build/
functions/lib/
**/functions/lib/
*.tsbuildinfo
.nyc_output/
coverage/
**/coverage/

# ── IDEs and Editors ───────────────────────
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*.iml
*.ipr
*.iws

# ── Logs ───────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ── Flutter / Mobile ───────────────────────
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/
**/android/local.properties
**/ios/Flutter/flutter_export_environment.sh
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/.plugin_symlinks/
**/ephemeral/
**/doc/api/

# ── Operating System ───────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ── Docker & Local Storage ─────────────────
postgres_data/
redis_data/
uploads/
**/uploads/
