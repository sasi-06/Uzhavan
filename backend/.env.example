# ── Firebase (Production / Dev) ──────────────────────────
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or specify JSON string directly:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ── Backend API ───────────────────────────────────────────
API_PORT=3000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
OTP_EXPIRES_SECONDS=300

# ── AWS S3 (machine photos) ───────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=uzhavan-uploads

# ── Payments (Razorpay) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Voice services ────────────────────────────────────────
BHASHINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
VOICE_SERVICE_URL=http://localhost:5005

# ── SMS / IVR ─────────────────────────────────────────────
SMS_API_KEY=
EXOTEL_SID=
EXOTEL_TOKEN=

# ── Maps ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Admin dashboard ───────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
