rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OTPs collection for phone verification
    match /otps/{phone} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
      
      match /private_location/{docId} {
        allow read, write: if true;
      }
    }

    // Machines collection
    match /machines/{machineId} {
      allow read, write: if true;
      
      match /bookedSlots/{date} {
        allow read, write: if true;
      }
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, write: if true;
      
      match /private_data/{docId} {
        allow read, write: if false; // Only Cloud Functions can access this
      }
    }
  }
}

